@import "tailwindcss";

/* ─── Premium Spotify-Inspired Theme ─── */
@theme {
  /* Deep dark palette - richer blacks */
  --color-dhwani-bg: #0a0a0a;
  --color-dhwani-surface: #121212;
  --color-dhwani-surface-light: #1a1a1a;
  --color-dhwani-surface-elevated: #242424;
  --color-dhwani-surface-hover: #2a2a2a;
  
  /* Vibrant accent colors */
  --color-dhwani-accent: #1db954;
  --color-dhwani-accent-soft: #1ed760;
  --color-dhwani-accent2: #1db954;
  --color-dhwani-accent3: #e91e63;
  --color-dhwani-accent4: #ff9800;
  --color-dhwani-purple: #9333ea;
  --color-dhwani-blue: #3b82f6;
  
  /* Text colors */
  --color-dhwani-text: #ffffff;
  --color-dhwani-text-secondary: #b3b3b3;
  --color-dhwani-muted: #727272;
  
  /* Glass & effects */
  --color-dhwani-border: rgba(255, 255, 255, 0.1);
  --color-dhwani-glass: rgba(255, 255, 255, 0.03);
  --color-dhwani-glow: rgba(29, 185, 84, 0.3);
  
  /* Semantic colors */
  --color-dhwani-success: #1db954;
  --color-dhwani-warning: #f59e0b;
  --color-dhwani-error: #ef4444;
}

/* ─── Base Reset ─── */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: 'Inter', 'SF Pro Display', ui-sans-serif, system-ui, -apple-system, 'Segoe UI',
    Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: var(--color-dhwani-bg);
  color: var(--color-dhwani-text);
  min-height: 100vh;
  overflow-x: hidden;
  background-image: 
    radial-gradient(ellipse at 20% 0%, rgba(138, 108, 255, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(0, 229, 255, 0.06) 0%, transparent 50%);
  background-attachment: fixed;
}

#root {
  min-height: 100vh;
}

/* ─── Scrollbar ─── */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(138, 108, 255, 0.3);
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(138, 108, 255, 0.5);
}

/* ─── Focus States ─── */
*:focus-visible {
  outline: 2px solid var(--color-dhwani-accent);
  outline-offset: 2px;
}

/* ─── Selection ─── */
::selection {
  background: rgba(138, 108, 255, 0.4);
  color: white;
}

/* ─── Premium Glass Effect ─── */
.glass {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--color-dhwani-border);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ─── Gradient Text ─── */
.gradient-text {
  background: linear-gradient(135deg, #1db954 0%, #1ed760 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-warm {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ─── Premium Buttons ─── */
.btn-primary {
  background: #1db954;
  color: #000000;
  font-weight: 700;
  padding: 0.875rem 2rem;
  border-radius: 500px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  transform: scale(1);
  letter-spacing: 0.02em;
}

.btn-primary:hover {
  background: #1ed760;
  transform: scale(1.04);
}

.btn-primary:active {
  transform: scale(1);
  background: #1aa34a;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: var(--color-dhwani-text);
  font-weight: 500;
  padding: 0.75rem 1.5rem;
  border-radius: 50px;
  border: 1px solid var(--color-dhwani-border);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

.btn-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--color-dhwani-border);
  color: var(--color-dhwani-text);
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-icon:hover {
  background: var(--color-dhwani-accent);
  border-color: var(--color-dhwani-accent);
  color: white;
}

/* ─── Card Styles ─── */
.card {
  background: var(--color-dhwani-surface);
  border-radius: 16px;
  border: 1px solid var(--color-dhwani-border);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-hover:hover {
  transform: translateY(-4px);
  border-color: rgba(138, 108, 255, 0.3);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 40px rgba(138, 108, 255, 0.1);
}

/* ─── Track Item ─── */
.track-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1rem;
  border-radius: 10px;
  transition: all 0.2s ease;
  cursor: pointer;
}

.track-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.track-item:hover .track-play-btn {
  opacity: 1;
  transform: scale(1);
}

.track-play-btn {
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.2s ease;
}

/* ─── Input Fields ─── */
.input {
  width: 100%;
  padding: 0.875rem 1.25rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--color-dhwani-border);
  border-radius: 12px;
  color: var(--color-dhwani-text);
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.input:focus {
  outline: none;
  border-color: var(--color-dhwani-accent);
  box-shadow: 0 0 0 3px rgba(138, 108, 255, 0.15);
}

.input::placeholder {
  color: var(--color-dhwani-muted);
}

/* ─── Navigation ─── */
.nav-link {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  padding: 0.75rem 1rem;
  border-radius: 6px;
  color: var(--color-dhwani-text-secondary);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9375rem;
  transition: all 0.15s ease;
}

.nav-link:hover {
  color: var(--color-dhwani-text);
}

.nav-link.active {
  color: white;
  background: var(--color-dhwani-surface-elevated);
  font-weight: 600;
}

/* ─── Glow Effects ─── */
.glow {
  box-shadow: 0 0 40px rgba(138, 108, 255, 0.3);
}

.glow-cyan {
  box-shadow: 0 0 40px rgba(0, 229, 255, 0.3);
}

/* ─── Animation Keyframes ─── */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { 
    opacity: 0;
    transform: translateY(20px);
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* ─── Animation Utilities ─── */
.animate-fade-in {
  animation: fadeIn 0.4s ease-out;
}

.animate-slide-up {
  animation: slideUp 0.5s ease-out;
}

.animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.animate-shimmer {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.05) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.animate-spin {
  animation: spin 1s linear infinite;
}

/* ─── Skeleton Loading ─── */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-dhwani-surface) 0%,
    var(--color-dhwani-surface-light) 50%,
    var(--color-dhwani-surface) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8px;
}

/* ─── Range Slider (for player) ─── */
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 4px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 2px;
  outline: none;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  background: white;
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  transition: transform 0.15s ease;
}

input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

input[type="range"]::-moz-range-thumb {
  width: 14px;
  height: 14px;
  background: white;
  border-radius: 50%;
  cursor: pointer;
  border: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

/* ─── Progress Bar ─── */
.progress-bar {
  width: 100%;
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-dhwani-accent) 0%, var(--color-dhwani-accent2) 100%);
  border-radius: 2px;
  transition: width 0.1s linear;
}

/* ─── Badge ─── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.75rem;
  background: rgba(138, 108, 255, 0.2);
  color: var(--color-dhwani-accent);
  border-radius: 50px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.badge-success {
  background: rgba(0, 214, 143, 0.2);
  color: var(--color-dhwani-success);
}

.badge-warning {
  background: rgba(255, 184, 0, 0.2);
  color: var(--color-dhwani-warning);
}

/* ─── Tooltip ─── */
.tooltip {
  position: relative;
}

.tooltip::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(-8px);
  padding: 0.5rem 0.75rem;
  background: var(--color-dhwani-surface-elevated);
  color: var(--color-dhwani-text);
  border-radius: 8px;
  font-size: 0.75rem;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
  pointer-events: none;
}

.tooltip:hover::after {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(-4px);
}

/* ─── Album Art Reflection ─── */
.album-reflection {
  position: relative;
}

.album-reflection::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) scaleY(-1);
  width: 80%;
  height: 50%;
  background: inherit;
  background-size: cover;
  opacity: 0.2;
  filter: blur(10px);
  mask-image: linear-gradient(to bottom, rgba(0,0,0,0.3), transparent);
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.3), transparent);
}

/* ─── Player Wave Animation ─── */
.wave-bar {
  width: 3px;
  height: 20px;
  background: linear-gradient(to top, var(--color-dhwani-accent), var(--color-dhwani-accent2));
  border-radius: 2px;
  animation: wave 1s ease-in-out infinite;
}

.wave-bar:nth-child(2) { animation-delay: 0.1s; }
.wave-bar:nth-child(3) { animation-delay: 0.2s; }
.wave-bar:nth-child(4) { animation-delay: 0.3s; }
.wave-bar:nth-child(5) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.5); }
  50% { transform: scaleY(1); }
}

/* ─── Premium Verified Badge ─── */
.verified-badge {
  width: 18px;
  height: 18px;
  background: linear-gradient(135deg, #1db954 0%, #1ed760 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ─── Fixed Layout System ─── */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 260px;
  height: 100vh;
  background: var(--color-dhwani-surface);
  border-right: 1px solid var(--color-dhwani-border);
  padding: 1.25rem;
  overflow-y: auto;
  z-index: 40;
}

.player-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90px;
  background: linear-gradient(to top, var(--color-dhwani-surface) 0%, rgba(18, 18, 18, 0.98) 100%);
  border-top: 1px solid var(--color-dhwani-border);
  padding: 0 1rem;
  z-index: 50;
  display: flex;
  align-items: center;
}

/* Legacy layout support */
.layout {
  display: flex;
  min-height: 100vh;
}

.main-content {
  flex: 1;
  margin-left: 260px;
  padding: 1.5rem;
  padding-bottom: 110px;
  overflow-y: auto;
  min-height: 100vh;
}

/* ─── Responsive ─── */
@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }
  
  .sidebar.open {
    transform: translateX(0);
  }
  
  .main-content {
    margin-left: 0;
  }
  
  .player-bar {
    padding: 0.5rem;
  }
}
